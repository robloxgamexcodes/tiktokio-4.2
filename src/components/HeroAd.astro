---
// 970x90 Google Ad Manager (GPT) banner, placed right after the URL input field in hero sections.
// - Shown only while the input form is on screen; hidden as soon as the result section replaces it.
// - Desktop only (>= 1024px): a 970px-wide banner cannot fit on smaller screens.
// - The <head> part (gpt.js + defineSlot) lives in src/layouts/Layout.astro; this file holds the body part.
// - NOT used in any result section.
---
<div id="hero-ad-wrapper" class="hidden lg:flex justify-center items-center w-full mt-4 mb-2">
  <!-- /21857590943,23337107551/rasuplus_tiktokio.cam/rasuplus_tiktokio.cams_970x90 -->
  <div id="div-gpt-ad-1795001676021-0" style="min-width:970px;min-height:90px;"></div>
</div>

<script is:inline>
  // Body part: render the ad into the div above (slot is defined in <head> in Layout.astro).
  window.googletag = window.googletag || { cmd: [] };
  googletag.cmd.push(function () { googletag.display('div-gpt-ad-1795001676021-0'); });
</script>

<script is:inline>
  // Show the hero ad only on the input screen, never on the result screen.
  (function () {
    var wrapper = document.getElementById('hero-ad-wrapper');
    if (!wrapper) return;
    var seenInput = false;

    function hasInputForm() {
      var root = wrapper.parentElement || document;
      return !!root.querySelector('input[type="text"], input[type="url"], input:not([type]), textarea');
    }

    function toggleHeroAd() {
      if (hasInputForm()) {
        seenInput = true;
        wrapper.style.display = '';
      } else if (seenInput) {
        // input form was replaced by the result section
        wrapper.style.display = 'none';
      }
    }

    toggleHeroAd();
    new MutationObserver(toggleHeroAd).observe(wrapper.parentElement || document.body, { childList: true, subtree: true });
  })();
</script>
