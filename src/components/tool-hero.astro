---
// Hero with the downloader tool and a page-specific H1 (used by the English landing pages
// that need their own heading instead of the shared tvd.hero.* keys).
import InputScreen from "./InputScreen";

const { title, subtitle } = Astro.props as { title: string; subtitle: string };
---

<div class="relative isolate pt-14 bg-gradient-to-r from-blue-800 to-indigo-900">
  <div class="sm:pt-10">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-6xl text-center">
        <h1 class="text-2xl font-bold tracking-tight text-white sm:text-4xl">{title}</h1>
        <p class="mt-2 text-lg leading-8 text-gray-100">{subtitle}</p>
        <InputScreen client:only="solid-js">
      <div slot="fallback" class="input-skeleton" aria-hidden="true"></div>
    </InputScreen>
      </div>
    </div>
  </div>
</div>
