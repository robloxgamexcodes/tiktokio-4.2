---
import GptAd from "./GptAd.astro";
import { ui } from "../i18n/ui";

// English homepage FAQ: renders home.faq.question1..N (answers may contain HTML)
const en = ui.en as Record<string, string>;
const faqs: { q: string; a: string }[] = [];
for (let n = 1; en[`home.faq.question${n}`]; n++) {
	faqs.push({ q: en[`home.faq.question${n}`], a: en[`home.faq.answer${n}`] });
}
const faqSchema = faqs.length
	? {
			'@context': 'https://schema.org',
			'@type': 'FAQPage',
			mainEntity: faqs.map((f) => ({
				'@type': 'Question',
				name: f.q,
				acceptedAnswer: { '@type': 'Answer', text: f.a },
			})),
		}
	: null;
---

{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
<div class="mx-auto max-w-7xl px-6 py-12 lg:px-8">
	<div class="mx-auto divide-y divide-gray-900/10">
		<div class="text-center mb-16">
			<h2 class="text-2xl md:text-3xl font-bold text-gray-900">{en["home.faq.title_sec1"]} <span class="text-orange-400">Tiktokio</span> - {en["home.faq.title_sec2"]}</h2>
			<div class="w-24 h-1 mx-auto bg-orange-400"></div>
			<p class="mt-4 mx-auto text-lg text-gray-900">{en["home.faq.faq_text"]}</p>
		</div>
		<section>
			<div class="grid md:grid-cols-2 gap-6">
				{faqs.map((f) => (
					<div class="rounded-lg border-color-blue shadow bg-card text-card-foreground shadow-sm">
						<div class="flex flex-col space-y-1.5 p-6">
							<h3 class="font-semibold tracking-tight text-lg">{f.q}</h3>
						</div>
						<div class="p-6 pt-0">
							<p class="text-muted-foreground" set:html={f.a} />
						</div>
					</div>
				))}
			</div>
		</section>
	</div>
</div>

<GptAd
  id="gpt-300x250"
  path="/213794966,23337107551/display-2026/tiktokio.com_300x250"
  sizes={[[320, 250], [1, 1], [300, 250]]}
  minHeight={250}
  class="my-6 flex justify-center"
/>
